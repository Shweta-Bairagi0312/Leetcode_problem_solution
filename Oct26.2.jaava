import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int t = sc.nextInt();

        while (t-- > 0) {
            int n = sc.nextInt();
            int min = n;

            for (int i = 0; i < n; i++) {
                int x = sc.nextInt();
                min = Math.min(min, x);
            }

            if (min < n) {
                System.out.println(n);
            } else {
                System.out.println(0);
            }
        }

        sc.close();
    }
}
